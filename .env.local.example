VAPI_ASSISTANT_ID=
# The assistant inbound calls reach when someone rings the number back. /admin audits its
# configuration too and reports a red incident until this is set — that assistant is the one
# found in production with recording left unset, which Vapi treats as recording ON.
VAPI_CALLBACK_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
# Auth via API Key instead of the classic Auth Token (twilio(apiKeySid, apiKeySecret, { accountSid }))
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
ANTHROPIC_API_KEY=
CRON_SECRET=
